# This environment file defines the connection parameters for connecting to Cloud SQL Postgres DB.

PORT=4000
DB_HOST=127.0.0.1
DB_PORT=9470
DB_USER=client                  #OR postgres
DB_PASSWORD=client12345         #OR Pjb-db12345
DB_NAME=pjb-web-db
DB_SSL=false

# The following environment variable is used to specify the API URL for the frontend application.
VITE_API_URL=http://34.160.158.137
# Add in cloudbuild.yaml file to set the API URL for the frontend application during the build process @2.1.
# - 'VITE_API_URL=http://34.160.158.137'

# Use the following environment variable to specify the Google Cloud service account to impersonate for accessing Cloud SQL. 
# This is necessary when running the backend on Cloud Run and connecting to a Cloud SQL instance using 
# the Cloud SQL Auth proxy from localhost.
GOOGLE_IMPERSONATED_SERVICE_ACCOUNT=cloud-sql-sa@prairiejoybaskets.iam.gserviceaccount.com